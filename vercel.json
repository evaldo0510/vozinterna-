
{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    { "src": "/service-worker.js", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/manifest.json", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
